# ============================================================
# remoteman 環境変数設定サンプル
# 使い方: このファイルを .env としてコピーし、値を設定してください
#   cp .env.example .env
# ============================================================

# JWT署名 と SSH認証情報(パスワード/秘密鍵)の暗号化の両方に使う秘密鍵。
# 生成コマンド:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 一度発行したサーバー登録情報を復号できなくなるため、運用開始後は変更しないでください。
APP_SECRET_KEY=

# 初回起動時にのみ作成される初期管理者アカウント。
# 2回目以降の起動では使われません(WebUIの「ユーザー管理」から追加・変更してください)。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# JWTトークンの有効期限(時間)。外部公開する場合は短めを推奨。
JWT_EXPIRE_HOURS=24

# WebUI/APIの待受ポート(ホスト側にも同じポート番号でマッピングされます)
APP_PORT=8091
